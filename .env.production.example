# Copy to .env.production outside version control and set real deployment values.
SRP_IMAGE_TAG=local
SRP_HOST_PORT=8443
SRP_MCP_RESOURCE_URL=https://provisioner.example.com/mcp
SRP_OIDC_ISSUER_URL=https://identity.example.com/
SRP_OIDC_AUDIENCE=shared-resource-provisioner
SRP_ADMIN_SUBJECTS=["replace-with-exact-oidc-subject"]
SRP_MUTATIONS_ENABLED=false

# Host paths. Prepare these with the ownership and permissions in DEPLOY.md.
SRP_DATA_DIR=/srv/shared-resource-provisioner/data
SRP_CONFIG_DIR=/srv/shared-resource-provisioner/config
SRP_SECRETS_DIR=/srv/shared-resource-provisioner/secrets
